{
  "openapi": "3.1.0",
  "info": {
    "title": "Tally API",
    "description": "Prices used laptops and explains each price line by line.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Api Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/options": {
      "get": {
        "summary": "Options",
        "operationId": "options_api_options_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FormOptions"
                }
              }
            }
          }
        }
      }
    },
    "/api/appraise": {
      "post": {
        "summary": "Appraise",
        "operationId": "appraise_api_appraise_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LaptopSpecs"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Appraisal"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Appraisal": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "currency": {
            "type": "string",
            "const": "NGN",
            "title": "Currency",
            "default": "NGN"
          },
          "condition_grade": {
            "type": "string",
            "enum": [
              "like_new",
              "good",
              "fair",
              "worn"
            ],
            "title": "Condition Grade",
            "description": "Worked out from issues with the shared ConditionRule."
          },
          "base_value": {
            "type": "integer",
            "title": "Base Value",
            "description": "Average price across the training data, before any answer counts."
          },
          "contributions": {
            "items": {
              "$ref": "#/components/schemas/Contribution"
            },
            "type": "array",
            "title": "Contributions"
          },
          "estimate": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Estimate"
          },
          "range": {
            "$ref": "#/components/schemas/PriceRange"
          },
          "model": {
            "$ref": "#/components/schemas/ModelInfo"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "created_at",
          "condition_grade",
          "base_value",
          "contributions",
          "estimate",
          "range",
          "model"
        ],
        "title": "Appraisal"
      },
      "ConditionRule": {
        "properties": {
          "points": {
            "additionalProperties": {
              "type": "integer"
            },
            "propertyNames": {
              "enum": [
                "scratches",
                "dent_or_crack",
                "screen_damage",
                "worn_keys",
                "something_broken",
                "loose_hinge",
                "repaired"
              ]
            },
            "type": "object",
            "title": "Points",
            "description": "Points each issue adds."
          },
          "min_points": {
            "additionalProperties": {
              "type": "integer"
            },
            "propertyNames": {
              "enum": [
                "like_new",
                "good",
                "fair",
                "worn"
              ]
            },
            "type": "object",
            "title": "Min Points",
            "description": "Fewest points needed for each grade."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "points",
          "min_points"
        ],
        "title": "ConditionRule"
      },
      "Contribution": {
        "properties": {
          "feature": {
            "type": "string",
            "title": "Feature",
            "description": "The LaptopSpecs field this line explains, such as 'ram_gb'."
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "title": "Label",
            "description": "Human wording for the slip, such as '16 GB RAM'."
          },
          "amount": {
            "type": "integer",
            "title": "Amount",
            "description": "Signed naira. Positive adds to the price, negative takes away."
          },
          "source": {
            "type": "string",
            "enum": [
              "model",
              "adjustment"
            ],
            "title": "Source",
            "description": "'model' when the model learned it; 'adjustment' when a fixed rule applied after the model set it, for answers the training data has no column for.",
            "default": "model"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "feature",
          "label",
          "amount"
        ],
        "title": "Contribution"
      },
      "FormOptions": {
        "properties": {
          "currency": {
            "type": "string",
            "const": "NGN",
            "title": "Currency",
            "default": "NGN"
          },
          "brands": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Brands"
          },
          "laptop_types": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Laptop Types"
          },
          "cpus": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Cpus"
          },
          "ram_gb": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "minItems": 1,
            "title": "Ram Gb"
          },
          "storage_gb": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "minItems": 1,
            "title": "Storage Gb"
          },
          "screen_inches": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "minItems": 1,
            "title": "Screen Inches"
          },
          "year_min": {
            "type": "integer",
            "title": "Year Min"
          },
          "year_max": {
            "type": "integer",
            "title": "Year Max"
          },
          "condition_rule": {
            "$ref": "#/components/schemas/ConditionRule"
          },
          "model": {
            "$ref": "#/components/schemas/ModelInfo"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "brands",
          "laptop_types",
          "cpus",
          "ram_gb",
          "storage_gb",
          "screen_inches",
          "year_min",
          "year_max",
          "condition_rule",
          "model"
        ],
        "title": "FormOptions"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LaptopSpecs": {
        "properties": {
          "brand": {
            "type": "string",
            "minLength": 1,
            "title": "Brand",
            "examples": [
              "Dell"
            ]
          },
          "model_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Name",
            "description": "Free text such as 'XPS 13'. The trained model reads the product line from it (ROG, ThinkPad, MacBook Air and so on)."
          },
          "laptop_type": {
            "type": "string",
            "minLength": 1,
            "title": "Laptop Type",
            "examples": [
              "Ultrabook"
            ]
          },
          "year": {
            "type": "integer",
            "maximum": 2100.0,
            "minimum": 2005.0,
            "title": "Year",
            "description": "Year the laptop came out."
          },
          "cpu": {
            "type": "string",
            "minLength": 1,
            "title": "Cpu",
            "examples": [
              "Intel Core i7"
            ]
          },
          "ram_gb": {
            "type": "integer",
            "maximum": 256.0,
            "minimum": 1.0,
            "title": "Ram Gb"
          },
          "storage_gb": {
            "type": "integer",
            "maximum": 16384.0,
            "minimum": 16.0,
            "title": "Storage Gb"
          },
          "storage_type": {
            "type": "string",
            "enum": [
              "ssd",
              "hdd"
            ],
            "title": "Storage Type"
          },
          "gpu": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "integrated",
                  "dedicated"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Gpu",
            "description": "Null when the seller isn't sure."
          },
          "screen_inches": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 20.0,
                "minimum": 10.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Screen Inches",
            "description": "Null when the seller isn't sure."
          },
          "issues": {
            "items": {
              "type": "string",
              "enum": [
                "scratches",
                "dent_or_crack",
                "screen_damage",
                "worn_keys",
                "something_broken",
                "loose_hinge",
                "repaired"
              ]
            },
            "type": "array",
            "title": "Issues",
            "description": "Every condition item the seller ticked. An empty list means 'None of these'."
          },
          "battery_runtime": {
            "type": "string",
            "enum": [
              "all_day",
              "half_day",
              "one_to_three_hours",
              "needs_charger",
              "unknown"
            ],
            "title": "Battery Runtime",
            "description": "How long a full charge lasts with everyday use."
          },
          "battery_health_pct": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Battery Health Pct",
            "description": "From the exact-health helper. When present it takes priority over battery_runtime."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "brand",
          "laptop_type",
          "year",
          "cpu",
          "ram_gb",
          "storage_gb",
          "storage_type",
          "issues",
          "battery_runtime"
        ],
        "title": "LaptopSpecs"
      },
      "ModelInfo": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "mock",
              "trained"
            ],
            "title": "Kind"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "mae": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Mae",
            "description": "Mean absolute error on the test set, in naira."
          },
          "r2": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "R2"
          },
          "trained_on_rows": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trained On Rows"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "name",
          "version",
          "mae"
        ],
        "title": "ModelInfo"
      },
      "PriceRange": {
        "properties": {
          "low": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Low"
          },
          "high": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "High"
          },
          "confidence": {
            "type": "number",
            "exclusiveMaximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Confidence",
            "description": "0.8 means 8 in 10 real prices fall in this range."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "low",
          "high",
          "confidence"
        ],
        "title": "PriceRange"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
